{{- $swCdnDomains := slice -}}
{{- range hugo.Data.cdn -}}
	{{- with .src -}}
		{{- $swCdnDomains = $swCdnDomains | append ((urls.Parse .).Host) -}}
	{{- end -}}
	{{- with .js -}}
		{{- with .src -}}
			{{- $swCdnDomains = $swCdnDomains | append ((urls.Parse .).Host) -}}
		{{- end -}}
	{{- end -}}
	{{- with .css -}}
		{{- with .src -}}
			{{- $swCdnDomains = $swCdnDomains | append ((urls.Parse .).Host) -}}
		{{- end -}}
	{{- end -}}
{{- end -}}

{{- $pages := slice -}}
{{- range hugo.Sites -}}
	{{- if not (.Dimension "version").IsDefault }}{{ continue }}{{ end -}}
	{{- range .Pages -}}
		{{- $pages = $pages | append .RelPermalink -}}
	{{- end -}}
{{- end -}}

{{- $swPrecacheAssets := slice -}}

{{- if .Site.Params.sw.precache.assets -}}
	{{- $swPrecacheAssets = $swPrecacheAssets | append (hugo.Store.Get "swPrecache") -}}
{{- end -}}

{
	"swVersion": "{{ now.UnixNano | xxhash | last 6 }}",
	"swCdnDomains": {{ $swCdnDomains | uniq | jsonify }},
	"swPrecacheHtml": {{ if .Site.Params.sw.precache.html }}true{{ else }}false{{ end }},
	"swPrecacheAssets": {{ $swPrecacheAssets | uniq | jsonify }},
	"swPages": {{ $pages | jsonify }}
}
